{
  "compilerOptions": {
    "types": ["node"],

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "isolatedModules": true
  },

  "include": ["src"],
  "exclude": [
    "tests",
    "**/*.test.ts",
    "dist",
    "node_modules"
  ]
}