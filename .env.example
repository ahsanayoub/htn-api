# Existing application settings
PORT=3000
DATABASE_URL=

# Cloudflare R2 S3 API credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Defaults to 900 seconds (15 minutes), capped at 7 days.
R2_PRESIGNED_URL_EXPIRES_SECONDS=900

# SerpAPI search provider (Talent Discovery)
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_MS=15000
SERPAPI_RESULTS_PER_PAGE=10

# Recruiter portal
RECRUITER_ALLOWED_ORIGINS=https://headsbaseinc.com,https://www.headsbaseinc.com
RECRUITER_PORTAL_URL=https://headsbaseinc.com

# Transactional email for verification and password reset
RESEND_API_KEY=
AUTH_EMAIL_FROM=Headsbase <no-reply@headsbaseinc.com>

# Optional comma-separated platform-admin email addresses
PLATFORM_ADMIN_EMAILS=

# HTN -> ATS submission sync
HTN_ATS_API_URL=
HTN_ATS_INTEGRATION_KEY=
# Optional. Set to 0/false/off to disable the in-process retry worker started by the API.
# HTN_ATS_SYNC_WORKER=1
# Optional. Total ATS sync attempts including the immediate first try. Default 8.
# HTN_ATS_SYNC_MAX_ATTEMPTS=8
