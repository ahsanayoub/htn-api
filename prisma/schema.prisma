generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String           @id @default(uuid()) @db.Uuid
  externalId    String?
  sourceVersion String?
  type          OrganizationType
  name          String
  legalName     String?
  website       String?          @unique
  linkedinUrl   String?
  logoUrl       String?
  industry      String?
  description   String?
  headquarters  String?
  employeeCount Int?
  foundedYear   Int?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  candidates    Candidate[]
  contacts      Contact[]
  documents     Document[]
  jobs          Job[]
  discoverySearches DiscoverySearch[]

  @@index([externalId])
  @@index([name])
  @@index([type])
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  externalId     String?
  sourceVersion  String?
  firstName      String
  lastName       String
  title          String?
  department     String?
  email          String?
  phone          String?
  linkedinUrl    String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([organizationId])
  @@index([lastName])
}

model Job {
  id                      String          @id @default(uuid()) @db.Uuid
  externalId              String?
  sourceVersion           String?
  source                  JobSource?
  organizationId          String          @db.Uuid
  title                   String
  slug                    String?         @unique
  summary                 String?
  description             String?
  descriptionHtml         String?
  responsibilities        String?
  requirements            String?
  preferredQualifications String?
  benefits                String?
  employmentType          EmploymentType?
  workplaceType           WorkplaceType?
  department              String?
  seniority               String?
  experienceMin           Int?
  experienceMax           Int?
  salaryMin               Decimal?
  salaryMax               Decimal?
  salaryCurrency          String?
  location                String?
  country                 String?
  city                    String?
  timezone                String?
  remote                  Boolean?
  openings                Int?
  postedAt                DateTime?
  expiresAt               DateTime?
  status                  JobStatus       @default(IMPORTED)
  visibility              JobVisibility   @default(PUBLIC)
  applyUrl                String?
  canonicalUrl            String?
  metadata                Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  lastSeenAt              DateTime?
  lastSyncedAt            DateTime?
  applications            Application[]
  documents               Document[]
  organization            Organization    @relation(fields: [organizationId], references: [id])
  jobSkills               JobSkill[]

  @@unique([source, externalId])
  @@index([externalId])
  @@index([source])
  @@index([organizationId])
  @@index([status])
  @@index([status, visibility])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([postedAt])
  @@index([lastSeenAt])
  @@index([lastSyncedAt])
}

model SourceSync {
  id            String    @id @default(uuid()) @db.Uuid
  source        JobSource @unique
  lastSyncAt    DateTime?
  lastSyncStart DateTime?
  totalSeen     Int?
  totalCreated  Int?
  totalUpdated  Int?
  totalFailed   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Candidate {
  id                    String           @id @default(uuid()) @db.Uuid
  externalId            String?
  sourceVersion         String?
  status                CandidateStatus  @default(NEW)
  firstName             String
  lastName              String
  headline              String?
  email                 String?
  phone                 String?
  linkedinUrl           String?
  portfolioUrl          String?
  githubUrl             String?
  website               String?
  currentTitle          String?
  location              String?
  country               String?
  city                  String?
  yearsExperience       Int?
  workAuthorization     String?
  availability          String?
  desiredSalary         Decimal?
  noticePeriod          Int?
  summary               String?
  metadata              Json?
  inTalentPool          Boolean          @default(false)
  contactConsent        Boolean          @default(false)
  contactConsentAt      DateTime?
  consentSource         String?
  currentOrganizationId String?          @db.Uuid
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  applications          Application[]
  currentOrganization   Organization?    @relation(fields: [currentOrganizationId], references: [id])
  candidateSkills       CandidateSkill[]
  documents             Document[]
  discoveredProfiles    DiscoveredProfile[]
  candidateSources      CandidateSource[]
  atsCandidateSync      HtnAtsCandidateSync?

  @@index([email])
  @@index([lastName])
  @@index([currentOrganizationId])
  @@index([inTalentPool])
  @@index([contactConsent])
}

model Application {
  id                String             @id @default(uuid()) @db.Uuid
  externalId        String?
  sourceVersion     String?
  candidateId       String             @db.Uuid
  jobId             String             @db.Uuid
  status            ApplicationStatus  @default(APPLIED)
  source            ApplicationSource?
  coverLetter       String?
  additionalNotes   String?
  salaryExpectation Decimal?
  noticePeriod      Int?
  submittedAt       DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  candidate         Candidate          @relation(fields: [candidateId], references: [id])
  job               Job                @relation(fields: [jobId], references: [id])
  atsSync           HtnAtsSubmissionSync?

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model Skill {
  id                  String                    @id @default(uuid()) @db.Uuid
  externalId          String?
  sourceVersion       String?
  name                String                    @unique
  metadata            Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  candidateSkills     CandidateSkill[]
  jobSkills           JobSkill[]
  categoryAssignments SkillCategoryAssignment[]
}

model SkillCategory {
  id            String                    @id @default(uuid()) @db.Uuid
  externalId    String?
  sourceVersion String?
  name          String                    @unique
  metadata      Json?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  assignments   SkillCategoryAssignment[]
}

model SkillCategoryAssignment {
  skillId    String        @db.Uuid
  categoryId String        @db.Uuid
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  skill      Skill         @relation(fields: [skillId], references: [id])

  @@id([skillId, categoryId])
  @@index([categoryId])
}

model CandidateSkill {
  candidateId     String    @db.Uuid
  skillId         String    @db.Uuid
  yearsExperience Int?
  proficiency     String?
  verified        Boolean?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  skill           Skill     @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
  @@index([skillId])
}

model JobSkill {
  jobId     String   @db.Uuid
  skillId   String   @db.Uuid
  required  Boolean?
  priority  Int?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id])
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
}

model Document {
  id              String        @id @default(uuid()) @db.Uuid
  externalId      String?
  sourceVersion   String?
  candidateId     String?       @db.Uuid
  jobId           String?       @db.Uuid
  organizationId  String?       @db.Uuid
  type            DocumentType
  storageProvider String?
  storageKey      String?
  fileName        String?
  mimeType        String?
  size            Int?
  checksum        String?
  version         Int           @default(1)
  isLatest        Boolean?      @default(true)
  uploadedBy      String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  candidate       Candidate?    @relation(fields: [candidateId], references: [id])
  job             Job?          @relation(fields: [jobId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([candidateId])
  @@index([jobId])
  @@index([organizationId])
  @@index([type])
}

enum OrganizationType {
  COMPANY
  CLIENT
  VENDOR
  MSP
  UNIVERSITY
  HOSPITAL
  PARTNER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DocumentType {
  RESUME
  COVER_LETTER
  CERTIFICATION
  PORTFOLIO
  OTHER
}

enum JobSource {
  MICRO1
  GREENHOUSE
  LEVER
  ASHBY
  WORKDAY
  LINKEDIN
  MANUAL
  OTHER
}

enum JobStatus {
  IMPORTED
  PARSED
  VALIDATED
  ACTIVE
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum JobVisibility {
  PUBLIC
  INTERNAL
}

enum CandidateStatus {
  NEW
  ACTIVE
  INTERVIEWING
  PLACED
  INACTIVE
  ARCHIVED
}

enum ApplicationSource {
  CAREERS_SITE
  RECRUITER
  REFERRAL
  IMPORT
  LINKEDIN
  OTHER
}

enum HtnAtsSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

/// Durable HTN → ATS synchronization record for a recruiter submission.
/// Authoritative sync state lives here, not in Application.metadata.
model HtnAtsSubmissionSync {
  id                      String           @id @default(uuid()) @db.Uuid
  applicationId           String           @unique @db.Uuid
  application             Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status                  HtnAtsSyncStatus @default(PENDING)
  attemptCount            Int              @default(0)
  lastAttemptAt           DateTime?
  nextRetryAt             DateTime?
  lastError               String?
  lastErrorCode           String?
  recruiterId             String?
  recruiterOrganizationId String?
  atsCandidateId          String?
  atsApplicationId        String?
  atsJobId                String?
  syncedAt                DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([status, nextRetryAt])
}

/// Durable HTN → ATS synchronization for Talent Network (candidate-only, no Application).
model HtnAtsCandidateSync {
  id             String           @id @default(uuid()) @db.Uuid
  htnCandidateId String           @unique @db.Uuid
  candidate      Candidate        @relation(fields: [htnCandidateId], references: [id], onDelete: Cascade)
  status         HtnAtsSyncStatus @default(PENDING)
  attemptCount   Int              @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  lastError      String?
  lastErrorCode  String?
  atsCandidateId String?
  syncedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, nextRetryAt])
}

enum SearchProvider {
  GOOGLE
  BING
  SERPER
  SERPAPI
  OTHER
}

enum DiscoverySearchStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DiscoveryRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DiscoveredProfileStatus {
  NEW
  REVIEWED
  IMPORTED
  DUPLICATE
  REJECTED
}

enum ProfileSource {
  LINKEDIN
  GITHUB
  WEBSITE
  OTHER
}

enum CandidateSourceType {
  APPLICATION
  LINKEDIN_XRAY
  REFERRAL
  MANUAL
  IMPORT
  API
  OTHER
}

model DiscoverySearch {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @db.Uuid
  name             String
  query            String
  roles            Json?
  skills           Json?
  locations        Json?
  companies        Json?
  status           DiscoverySearchStatus     @default(DRAFT)
  metadata         Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization              @relation(fields: [organizationId], references: [id])
  runs             DiscoverySearchRun[]
  candidateSources CandidateSource[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
}

model DiscoverySearchRun {
  id           String             @id @default(uuid()) @db.Uuid
  searchId     String             @db.Uuid
  provider     SearchProvider
  status       DiscoveryRunStatus @default(PENDING)
  resultCount  Int?
  newProfiles  Int?
  duplicates   Int?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  metadata     Json?
  createdAt    DateTime          @default(now())
  search       DiscoverySearch   @relation(fields: [searchId], references: [id])
  profiles     DiscoveredProfile[]

  @@index([searchId])
  @@index([status])
  @@index([provider])
  @@index([searchId, status])
}

model DiscoveredProfile {
  id             String                   @id @default(uuid()) @db.Uuid
  searchRunId    String                   @db.Uuid
  source         ProfileSource
  profileUrl     String
  normalizedUrl  String
  name           String?
  headline       String?
  location       String?
  snippet        String?
  status         DiscoveredProfileStatus  @default(NEW)
  confidence     Float?
  rawData        Json?
  metadata       Json?
  discoveredAt   DateTime                 @default(now())
  reviewedAt     DateTime?
  candidateId    String?                  @db.Uuid
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  searchRun      DiscoverySearchRun       @relation(fields: [searchRunId], references: [id])
  candidate      Candidate?               @relation(fields: [candidateId], references: [id])

  @@unique([searchRunId, normalizedUrl])
  @@index([normalizedUrl])
  @@index([searchRunId])
  @@index([searchRunId, status])
  @@index([candidateId])
  @@index([status])
  @@index([source])
}

model CandidateSource {
  id           String              @id @default(uuid()) @db.Uuid
  candidateId  String              @db.Uuid
  type         CandidateSourceType
  sourceUrl    String?
  searchId     String?             @db.Uuid
  metadata     Json?
  createdAt    DateTime            @default(now())
  candidate    Candidate           @relation(fields: [candidateId], references: [id])
  search       DiscoverySearch?    @relation(fields: [searchId], references: [id])

  @@index([candidateId])
  @@index([type])
  @@index([searchId])
}
